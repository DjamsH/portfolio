---
import Count from './Count.astro';
import { keyFigures } from '../content/site';
---

<section class="wrap" aria-labelledby="chiffres-title">
  <h2 id="chiffres-title" class="sr-only">Chiffres clés</h2>
  <span class="rule" data-rule></span>
  <ul class="grid grid-cols-2 lg:grid-cols-4">
    {
      keyFigures.map((figure, index) => (
        <li
          class:list={[
            'border-ink py-7 lg:py-10',
            index % 2 === 1 && 'border-l pl-5 lg:pl-8',
            index % 2 === 0 && index > 0 && 'lg:border-l lg:pl-8',
            index > 1 && 'border-t lg:border-t-0',
          ]}
        >
          <p class="figure-value text-[clamp(54px,7.2vw,104px)]">
            <Count figure={figure} />
          </p>
          <p class="mt-3 max-w-[22ch] text-[15px] leading-snug text-ink-2">{figure.label}</p>
        </li>
      ))
    }
  </ul>
  <span class="rule rule-thin" data-rule></span>
</section>
