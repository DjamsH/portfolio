---
import ClientLogo from './ClientLogo.astro';
import Count from './Count.astro';
import Rich from './Rich.astro';
import ToolLogo from './ToolLogo.astro';
import VizLineage from './viz/VizLineage.astro';
import VizMesh from './viz/VizMesh.astro';
import VizMigration from './viz/VizMigration.astro';
import VizPipeline from './viz/VizPipeline.astro';
import type { CaseStudy } from '../content/site';
import { getClient, getTools } from '../lib/content';

interface Props {
  study: CaseStudy;
}
const { study } = Astro.props;
const client = getClient(study.clientId);
const tools = getTools(study.tools);
const titleId = `cas-${study.id}-titre`;
---

<article id={`cas-${study.id}`} aria-labelledby={`${titleId}-rang ${titleId}`} data-case>
  <span class="rule rule-thin" data-rule></span>
  <div class="grid-12 gap-y-10 pt-8 pb-20 lg:pt-10 lg:pb-32">
    <div class="case-sticky col-span-12 lg:col-span-2">
      <p class="case-number" aria-hidden="true">{study.number}</p>
    </div>

    <div class="col-span-12 lg:col-span-6">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        {
          client?.enabled ? (
            <ClientLogo client={client} height={22} />
          ) : (
            <p class="text-[15px] font-semibold tracking-[0.1em] uppercase">{client?.name}</p>
          )
        }
        <p class="label">{study.period} · {study.place}</p>
      </div>

      <p id={`${titleId}-rang`} class="sr-only">Étude de cas {study.number}, {client?.name}</p>
      <h3 id={titleId} class="case-title mt-6" data-split>
        <Rich text={study.title} />
      </h3>

      <p class="label mt-6">{study.role}</p>
      <p class="mt-3 max-w-[58ch] text-[17px] leading-[1.6] text-ink-2">{study.context}</p>

      <ul class="case-points mt-7 max-w-[58ch] space-y-2.5 text-[15px] leading-normal text-ink-2">
        {study.points.map((point) => <li>{point}</li>)}
      </ul>

      {
        tools.length > 0 && (
          <ul
            class="mt-9 flex flex-wrap gap-x-6 gap-y-3 border-t border-ink pt-5 text-[14px]"
            aria-label="Outils de la mission"
          >
            {tools.map((tool) => (
              <li>
                <ToolLogo tool={tool} />
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="case-sticky col-span-12 lg:col-span-4 lg:pl-6">
      <figure class="max-w-[400px]">
        {study.visual === 'pipeline' && <VizPipeline alt={study.visualAlt} />}
        {study.visual === 'lineage' && <VizLineage alt={study.visualAlt} />}
        {study.visual === 'mesh' && <VizMesh alt={study.visualAlt} />}
        {
          study.visual === 'migration' && (
            <VizMigration alt={study.visualAlt} total={study.figures[0]?.value ?? 0} />
          )
        }
      </figure>

      <ul class="mt-8 grid grid-cols-2 gap-x-6 lg:grid-cols-1">
        {
          study.figures.map((figure) => (
            <li class="border-t border-ink py-4">
              <p class="figure-value text-[clamp(40px,4vw,56px)]">
                <Count figure={figure} />
              </p>
              <p class="mt-1.5 text-[14px] leading-snug text-ink-2">{figure.label}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</article>
