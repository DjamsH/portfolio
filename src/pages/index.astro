---
import Base from '../layouts/Base.astro';
import Cases from '../components/Cases.astro';
import Clients from '../components/Clients.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import IconSprite from '../components/IconSprite.astro';
import KeyFigures from '../components/KeyFigures.astro';
import Masthead from '../components/Masthead.astro';
import Offers from '../components/Offers.astro';
import Parcours from '../components/Parcours.astro';
import Stack from '../components/Stack.astro';
---

<Base>
  <IconSprite />
  <Masthead />
  <main id="contenu">
    <Hero />
    <KeyFigures />
    <Clients />
    <Cases />
    <Parcours />
    <Stack />
    <Offers />
    <Contact />
  </main>
  <Footer />
</Base>
